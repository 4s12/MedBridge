rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function myDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function myRole() { return myDoc().role; }
    function isDoctor() { return verified() && myRole() == 'doctor'; }
    function isAdmin()  { return verified() && myRole() == 'admin'; }

    // ─── User profiles ────────────────────────────────────────────────
    // Role can be set only at creation and never changed to 'admin'.
    match /users/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid || isDoctor() || isAdmin()
      );
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role in ['patient', 'doctor'];
      allow update: if signedIn() && (
        // Owner can update own doc but cannot change role
        (request.auth.uid == uid
         && request.resource.data.role == resource.data.role)
        // Admin can update any user (e.g. enable/disable)
        || isAdmin()
      );
    }

    // ─── Public doctor directory ──────────────────────────────────────
    match /doctors/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() && (
        (request.auth.uid == id && isDoctor())
        || isAdmin()
      );
    }

    // ─── Appointments ─────────────────────────────────────────────────
    match /appointments/{id} {
      allow read: if signedIn() && (
        resource.data.patientId == request.auth.uid
        || resource.data.doctorId == request.auth.uid
        || isAdmin()
      );
      allow create: if verified()
                    && request.resource.data.patientId == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow update: if verified() && (
        resource.data.patientId == request.auth.uid
        || resource.data.doctorId == request.auth.uid
        || isAdmin()
      );
    }

    // ─── Slot locks (prevent double booking) ──────────────────────────
    match /bookedSlots/{id} {
      allow read, create, delete: if verified();
    }

    // ─── Medical records ──────────────────────────────────────────────
    match /records/{id} {
      allow read: if signedIn() && (
        resource.data.patientId == request.auth.uid
        || isDoctor()
        || isAdmin()
      );
      allow create: if verified()
                    && request.resource.data.addedBy == request.auth.uid
                    && (request.resource.data.patientId == request.auth.uid || isDoctor());
      allow delete: if verified() && resource.data.addedBy == request.auth.uid;
    }

    // ─── Prescriptions ───────────────────────────────────────────────
    match /prescriptions/{id} {
      allow read: if signedIn() && (
        resource.data.patientId == request.auth.uid
        || resource.data.doctorId == request.auth.uid
        || isAdmin()
      );
      allow create: if isDoctor()
                    && request.resource.data.doctorId == request.auth.uid;
    }

    // ─── Notifications ───────────────────────────────────────────────
    match /notifications/{id} {
      allow read, update, delete: if signedIn()
                                  && resource.data.userId == request.auth.uid;
      allow create: if signedIn();
    }

    // ─── Chat ────────────────────────────────────────────────────────
    match /chats/{chatId} {
      allow read, create, update: if verified();
      match /messages/{msgId} {
        allow read, create: if verified();
        allow update: if verified(); // for read receipts
      }
    }

    // ─── Reviews ─────────────────────────────────────────────────────
    match /reviews/{id} {
      allow read: if signedIn();
      allow create: if verified()
                    && request.resource.data.patientId == request.auth.uid;
    }

    // ─── Invoices ────────────────────────────────────────────────────
    match /invoices/{id} {
      allow read: if signedIn() && (
        resource.data.patientId == request.auth.uid
        || resource.data.doctorId == request.auth.uid
        || isAdmin()
      );
      allow create, update: if verified();
    }
  }
}
